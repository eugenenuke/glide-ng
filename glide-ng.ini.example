# ==============================================================================
# glide-ng Configuration Template (copy to `glide-ng.ini` to activate)
#
# Precedence (lowest to highest):
#   1. Built-in defaults
#   2. glide-ng.ini (or custom path via GLIDE_NG_CONFIG=/path/to/file.ini)
#   3. Authentic 3dfx environment variables (FX_GLIDE_* / SST_* / SSTV2_* / SSTH3_*)
#   4. glide-ng environment variables (GLIDE_NG_*)
#
# Comments start with `#` or `;`. Inline comments require preceding whitespace.
# ==============================================================================

[core]
# Rendering backend: vulkan (vk) | opengl_es (gles) | software (sw)
backend = vulkan
# GPU selection policy: default (OS/loader order) | discrete | integrated | llvmpipe | name:<substr>
gpu = default
# Run off-screen without creating a visible window (useful for CI/benchmarks)
headless = false

[hardware]
# Emulated 3dfx board: VoodooGraphics (SST1) | VoodooRush (SST96) |
#                      Voodoo2 (CVG) | VoodooBanshee (Banshee) | Voodoo3 (H3) |
#                      Voodoo4 (VSA100) | Voodoo5 (H5)
card_model = Voodoo2
# Glide 2.x/3.x reported API version (omit to use the card's authentic default):
#   VoodooGraphics/Rush: 2.11..2.48 / 3.00..3.04 | Voodoo2: 2.50..2.56 / 3.01..3.03
#   Banshee/Voodoo3: 2.60..2.61 / 3.10           | Voodoo4/Voodoo5: 2.61 / 3.10
api_version = 2.56
# Framebuffer RAM (FBI) in MB
fbi_memory_mb = 16
# Active Texture Mapping Units (1..3)
tmu_count = 2
# Texture RAM per TMU in MB
tmu_memory_mb = 16
# Report SLI capability (Voodoo Graphics SST-1 and Voodoo2; SST_SLIDETECT / SSTV2_SLIDETECT)
sli = false
# Optional reported vendor / renderer strings (grGetString)
# vendor = 3Dfx Interactive
# renderer = 3dfx glide-ng Vulkan Wrapper

[display]
# Vertical sync: true | false | fifo (strict FIFO on Wayland)
vsync = true
# Frame rate cap in FPS (0 = uncapped)
max_fps = 60
# Integer window scale factor (1..8)
window_scale = 1
# Borderless desktop fullscreen mode: auto | true | false
#   auto (default): borderless fullscreen on Win32/Wine (matching authentic 3dfx hardware), windowed on Linux standalone
#   true:  always expand to borderless desktop fullscreen with 4:3 pillarbox/letterbox
#   false: always stay windowed at the application's native resolution
fullscreen = auto
# Presentation scaling filter: nearest | linear
presentation_filter = nearest
# Multisample anti-aliasing samples: 1 | 2 | 4 | 8 | 16
msaa = 1

[logging]
# Log verbosity: off (0) | crit (1) | warn (2) | info (3) | debug (4) | trace (5)
level = info
# Log output file path
file = glide-ng.log
# Also mirror log lines to stdout
console = false
# Comma-separated categories: all | general | api | lfb | tex | state | draw | wsi | perf
categories = all
# Optional frame window filter for verbose logging (e.g. 120-125, 10, 50-, -20)
# trace_frames = 120-125
# Periodic [Perf] summaries (true/false) or path to per-frame CSV output
# perf_log = /tmp/glide-ng-perf.csv

[hud]
# DXVK-style on-screen HUD elements (key alias: `hud`, comma/semicolon-separated):
#   off | none | 0 | false | fps | 1 | on | true | frametimes | frametime |
#   backend | devinfo | api | drawcalls | draws | lfb | full | all
#   (also accepts inline options, e.g. `full,pos=br,scale=1.5,opacity=0.65`)
# elements = fps,frametimes,backend
# Corner placement (key alias: `pos`):
# position = top-left        # tl/top-left/topleft | tr/top-right/topright | bl/bottom-left/bottomleft | br/bottom-right/bottomright
# scale = 1.0                # 0.25 .. 4.0 (clamped, relative to guest resolution)
# opacity = 0.0              # 0.0 (borderless text+shadow, default) .. 1.0 (opaque) (clamped)

[glide]
# Authentic 3dfx overrides (equivalent to FX_GLIDE_* / SST_* / SSTV2_* / SSTH3_* env vars)
no_splash = false            # Suppress 3dfx startup splash animation
# shameless_plug = -1        # -1 = app-controlled | 0 = force off | 1 = force on
# swap_interval = 1          # 0 = vsync off | >=1 = swap interval
# gamma = 1.0                # Scalar gamma override (SST_GAMMA / SSTV2_GAMMA)
# gamma_r = 1.0              # Per-channel red gamma (SST*_RGAMMA)
# gamma_g = 1.0              # Per-channel green gamma (SST*_GGAMMA)
# gamma_b = 1.0              # Per-channel blue gamma (SST*_BGAMMA)
# gamma_rgb = 1.0 1.0 1.0    # Combined RGB gamma override (FX_GLIDE_GAMMARGB)
# use_app_gamma = true       # false ignores app gamma calls (FX_GLIDE_USE_APP_GAMMA=0)
# screen_refresh = 60        # Refresh pacing hint in Hz (SST*_SCREENREFRESH / FX_GLIDE_REFRESH)
# ignore_reopen = false      # Ignore redundant grSstWinOpen while window is active
# no_dither_sub = false      # Disable 16-bit dither quantization (FX_GLIDE_NO_DITHER_SUB)
# force_bilinear = false     # Force bilinear texture filtering (SSTV2_FORCE_BILINEAR)
# force_trilinear = false    # Force trilinear mipmap filtering (SSTV2_FORCE_TRILINEAR)
# texmap_disable = false     # Bypass texture sampling for diagnostics (SST*_TEXMAP_DISABLE)
# bounds_check = false       # Warn on out-of-bounds / non-finite vertices (FX_GLIDE_BOUNDS_CHECK)
# alloc_color = 2            # Override color buffer count: 2 | 3 (FX_GLIDE_ALLOC_COLOR / SSTV2_ALLOC_COLOR / SST_TRIPLE_BUFFER)
# alloc_aux = 1              # Override aux/depth buffer count: 0 | 1 (FX_GLIDE_ALLOC_AUX / SSTV2_ALLOC_AUX)
# report_real_hw = false     # Voodoo2 grSstQueryHardware: true returns GR_SSTTYPE_Voodoo2 (3); env FX_GLIDE_REPORT_REAL_HW uses strict != NULL (any set value, incl. 0, enables it)
# emul_rush = false          # Banshee/V3/V4/V5 grSstQueryHardware: true returns GR_SSTTYPE_SST96 (FX_GLIDE_EMUL_RUSH)
# texture_uma = -1           # -1 = app-controlled | 0 = off at init | 1 = on at init (FX_GLIDE_TEXTURE_UMA)
# snapshot = /tmp/snap.ppm   # Capture pre-RAMDAC PPM framebuffer snapshot(s): 1 | @N | @A,B,C | @[START]+STEP[:MAX] | path[@spec]

[software]
# Worker threads for Software backend (0 = auto-detect hardware concurrency)
threads = 0
# Software & shared-CPU SIMD tier: avx2 (default) | avx512 | scalar | auto (0/1 accepted)
simd = avx2
# Tile bin dimension in pixels (>= 16, power of two)
tile_size = 32
# Anti-aliasing mode: analytical | ssaa
aa = analytical

[vulkan]
# Persistent Vulkan pipeline cache path
cache_path = .glide-ng-vkcache.bin

[opengl_es]
# Dynamic vertex ring buffer size in MB
vbo_size_mb = 8
