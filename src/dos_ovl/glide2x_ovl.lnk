# Open Watcom wlink directive file for glide-ng clean-room GLIDE2X.OVL
# Produces a flat 32-bit OS/2 LE DLL (DOS/4GW / CauseWay / 3dfx LoadModule compatible)
# exporting all 130 DOSBox Glide 2.x bridge symbols plus Glide 2.11 guFb* wrappers
# in the LE Resident Name Table using 3dfx's uppercase _NAME@N convention.

format os2 le dll
option quiet
option caseexact
option nodefaultlibs
option modname='glide2x'

export '_GRAADRAWLINE@8'='_grAADrawLine@8' resident
export '_GRAADRAWPOINT@4'='_grAADrawPoint@4' resident
export '_GRAADRAWPOLYGON@12'='_grAADrawPolygon@12' resident
export '_GRAADRAWPOLYGONVERTEXLIST@8'='_grAADrawPolygonVertexList@8' resident
