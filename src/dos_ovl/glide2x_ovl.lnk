export '_GRALPHACONTROLSITRGBLIGHTING@4'='_grAlphaControlsITRGBLighting@4' resident
export '_GRALPHATESTFUNCTION@4'='_grAlphaTestFunction@4' resident
export '_GRALPHATESTREFERENCEVALUE@4'='_grAlphaTestReferenceValue@4' resident
export '_GRBUFFERCLEAR@12'='_grBufferClear@12' resident
